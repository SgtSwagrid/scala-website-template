# SITE_ADDRESS is a domain name, for which Caddy obtains and renews a
# certificate by itself, or `:80` to serve plain HTTP on any address.
{$SITE_ADDRESS} {

	# Compress static content only: responses streamed as text/plain arrive
	# piece by piece, and must not wait on a compressor's buffer.
	encode {
		match {
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type image/svg+xml*
		}
	}

	reverse_proxy app:8080 {
		flush_interval -1
	}
}
